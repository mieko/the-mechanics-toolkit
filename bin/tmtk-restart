#!/usr/bin/env node
import os from "node:os";
import path from "node:path";
import { spawnSync } from "node:child_process";
import { fileURLToPath } from "node:url";

if (process.env.TMTK_AUTOMATIC_REPAIR === "1") {
  fail("tmtk-restart: automatic repair turns cannot arm another supervisor", 1);
}

const {application, candidate, candidateSource, knownGood, prompt} =
  parseArguments(process.argv.slice(2));

const directory = path.dirname(fileURLToPath(import.meta.url));
const supervisor = path.join(directory, "safe-start-supervisor.mjs");
const rescueFile = path.join(os.homedir(), ".codex", "RESCUE-AGENT.json");
const supervisorArguments = [
  supervisor,
  "launch",
  application,
  rescueFile,
  prompt ?? "",
  candidate ?? "",
  candidateSource ?? "",
  knownGood ?? ""
];
const result = spawnSync(process.execPath, supervisorArguments, {
  stdio: "inherit",
  env: process.env
});
if (result.error != null) fail(`tmtk-restart: ${result.error.message}`, 1);
process.exit(result.status ?? 1);

function fail(message, code) {
  process.stderr.write(`${message}\n`);
  process.exit(code);
}

function parseArguments(values) {
  const positional = [];
  let candidate = null;
  let candidateSource = null;
  let knownGood = null;
  let prompt = null;
  let options = true;
  for (let index = 0; index < values.length; index += 1) {
    const value = values[index];
    if (options && value === "--") {
      options = false;
    } else if (options && value === "--prompt") {
      if (prompt != null || index + 1 >= values.length) usage();
      prompt = values[index += 1];
      if (prompt.trim() === "") usage();
    } else if (options && value === "--candidate") {
      if (candidate != null || index + 1 >= values.length) usage();
      candidate = values[index += 1];
      if (candidate.trim() === "") usage();
    } else if (options && value === "--candidate-source") {
      if (candidateSource != null || index + 1 >= values.length) usage();
      candidateSource = values[index += 1];
      if (candidateSource.trim() === "") usage();
    } else if (options && value === "--known-good") {
      if (knownGood != null || index + 1 >= values.length) usage();
      knownGood = values[index += 1];
      if (knownGood.trim() === "") usage();
    } else if (options && value.startsWith("-")) {
      usage();
    } else {
      positional.push(value);
    }
  }
  if (positional.length !== 1) usage();
  if ((candidateSource != null || knownGood != null) && candidate == null) usage();
  return {application: positional[0], candidate, candidateSource, knownGood, prompt};
}

function usage() {
  fail("usage: tmtk-restart [--candidate STAGED_APP] [--candidate-source SOURCE_DEB] " +
    "[--known-good ROLLBACK_DEB] " +
    "[--prompt TEXT] [--] CHATGPT_APPLICATION_ROOT", 2);
}
